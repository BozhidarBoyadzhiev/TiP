# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml for local runs).
# TIP_DB_PORT is the host port docker compose publishes PostgreSQL on. docker compose reads it from this
# .env file, so this line must be in your .env: a .env copied from an older .env.example does not have it,
# and compose then silently uses 5432. Change it if 5432 is taken, and use the same port in the URL below.
TIP_DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tip
SPRING_DATASOURCE_USERNAME=tip
SPRING_DATASOURCE_PASSWORD=tip

# HTTP port of the app, 8080 by default. Uncomment and change it when another program already uses 8080,
# and use the same port in TIP_PUBLIC_BASE_URL and in the fake device's --url.
# SERVER_PORT=8080

# Public origin of this app, used for links. Example: https://tip.example.com
TIP_PUBLIC_BASE_URL=http://localhost:8080

# PayPal REST app (sandbox). Create one at developer.paypal.com > Apps & Credentials.
# Base URL defaults to the sandbox; set https://api-m.paypal.com only for live.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered on the PayPal app, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# Tip rules. Amounts are minor units (pence for GBP).
TIP_CURRENCY=GBP
TIP_MIN_MINOR=100
TIP_MAX_MINOR=10000
TIP_PRESET_AMOUNTS_MINOR=100,200,500

# Optional demo owner, created on startup when no owner has this email. There is no public sign up,
# so this is how you get an owner login at /owner/login. The password is only used when the owner is
# created (changing it later has no effect) and must be 12 to 72 characters. The name defaults to the email.
TIP_DEMO_OWNER_EMAIL=
TIP_DEMO_OWNER_PASSWORD=
TIP_DEMO_OWNER_NAME=

# Optional demo device, created on startup and owned by the demo owner, which must then be set too.
# Slug: lowercase letters, digits and hyphens, 3 to 40 characters.
TIP_DEMO_DEVICE_SLUG=
TIP_DEMO_DEVICE_NAME=
# Device secret: base64url of 32 random bytes, required with a slug. Only its SHA-256 is stored, and
# changing it here rotates the secret on the next start. Generate one as shown in README.md.
TIP_DEMO_DEVICE_SECRET=

# Claude reads tip messages and picks the panda's reaction. With TIP_AI_ENABLED=false every tip reacts
# NEUTRAL and no key is needed. With true (the default) the app refuses to start without a key.
TIP_AI_ENABLED=true
# API key from console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Model id, defaults to claude-haiku-5-5.
TIP_AI_MODEL=claude-haiku-5-5
