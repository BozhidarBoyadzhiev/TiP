# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml for local runs).
# Host port docker compose publishes PostgreSQL on. Change it if 5432 is taken, and match the URL below.
TIP_DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tip
SPRING_DATASOURCE_USERNAME=tip
SPRING_DATASOURCE_PASSWORD=tip

# Public origin of this app, used for links. Example: https://tip.example.com
TIP_PUBLIC_BASE_URL=http://localhost:8080

# PayPal REST app (sandbox). Create one at developer.paypal.com > Apps & Credentials.
# Base URL defaults to the sandbox; set https://api-m.paypal.com only for live.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered on the PayPal app, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# Tip rules. Amounts are minor units (pence for GBP).
TIP_CURRENCY=GBP
TIP_MIN_MINOR=100
TIP_MAX_MINOR=10000
TIP_PRESET_AMOUNTS_MINOR=100,200,500

# Optional demo device, created on startup when it does not exist.
# Slug: lowercase letters, digits and hyphens, 3 to 40 characters.
TIP_DEMO_DEVICE_SLUG=
TIP_DEMO_DEVICE_NAME=
