# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.yml for local runs).
# TIP_DB_PORT is the host port docker compose publishes PostgreSQL on. docker compose reads it from this
# .env file, so this line must be in your .env: a .env copied from an older .env.example does not have it,
# and compose then silently uses 5432. Change it if 5432 is taken, and use the same port in the URL below.
TIP_DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tip
SPRING_DATASOURCE_USERNAME=tip
SPRING_DATASOURCE_PASSWORD=tip
# Optional maximum number of database connections, 5 by default. Keep it small on a small hosted database.
# TIP_DB_POOL_SIZE=5

# HTTP port of the app, 8080 by default. Uncomment and change it when another program already uses 8080,
# and use the same port in TIP_PUBLIC_BASE_URL and in the fake device's --url. A PORT variable (set by
# Render) also changes the port, but SERVER_PORT wins over it.
# SERVER_PORT=8080

# Header the client address is read from, X-Forwarded-For by default. Only change it on a host whose edge
# overwrites a single value header such as True-Client-IP or CF-Connecting-IP (see docs/DEPLOYMENT.md).
# TIP_CLIENT_IP_HEADER=X-Forwarded-For

# Public origin of this app, used for links. Example: https://tip.example.com
TIP_PUBLIC_BASE_URL=http://localhost:8080

# PayPal REST app (sandbox). Create one at developer.paypal.com > Apps & Credentials.
# Base URL defaults to the sandbox; set https://api-m.paypal.com only for live.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered on the PayPal app, used to verify webhook signatures.
PAYPAL_WEBHOOK_ID=

# Tip rules. Amounts are minor units (pence for GBP).
TIP_CURRENCY=GBP
TIP_MIN_MINOR=100
TIP_MAX_MINOR=10000
TIP_PRESET_AMOUNTS_MINOR=100,200,500

# Optional demo owner, created on startup when no owner has this email. There is no public sign up,
# so this is how you get an owner login at /owner/login. The password is only used when the owner is
# created (changing it later has no effect) and must be 12 to 72 characters. The name defaults to the email.
TIP_DEMO_OWNER_EMAIL=
TIP_DEMO_OWNER_PASSWORD=
TIP_DEMO_OWNER_NAME=

# Optional demo device, created on startup and owned by the demo owner, which must then be set too.
# Slug: lowercase letters, digits and hyphens, 3 to 40 characters.
TIP_DEMO_DEVICE_SLUG=
TIP_DEMO_DEVICE_NAME=
# Device secret: base64url of 32 random bytes, required with a slug. Only its SHA-256 is stored, and
# changing it here rotates the secret on the next start. Generate one as shown in docs/SETUP.md.
TIP_DEMO_DEVICE_SECRET=

# Claude reads tip messages and picks the panda's reaction. With TIP_AI_ENABLED=false every tip reacts
# PLAIN and no key is needed. With true (the default) the app refuses to start without a key.
TIP_AI_ENABLED=true
# API key from console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Model id, defaults to claude-haiku-5-5.
TIP_AI_MODEL=claude-haiku-5-5

# Access codes for judge sandboxes: entries label:sha256hex:expiresAt separated by ;, for example
# judges:<64 hex>:2026-12-31T23:59:59Z. Make each with ./gradlew newAccessCode -Plabel=judges -Pexpires=<ISO time>,
# which prints the code once and this entry. Only the hash goes here; never commit or paste a code. Empty means none.
TIP_ACCESS_CODES=

# Optional PayPal sandbox test details shown to judges in their sandbox (Test payment details). Take a
# sandbox card from https://developer.paypal.com/tools/sandbox/card-testing/ and a sandbox personal account from
# Sandbox Accounts. Sandbox only, no real money; still never commit them. The card shows only when all three
# card values are set, the account only when both of its values are set.
TIP_JUDGE_CARD_NUMBER=
TIP_JUDGE_CARD_EXPIRY=
TIP_JUDGE_CARD_CVC=
TIP_JUDGE_PAYPAL_EMAIL=
TIP_JUDGE_PAYPAL_PASSWORD=

# Optional per client IP limits (defaults in docs/DEPLOYMENT.md). Raise them, never lower them below honest use.
# TIP_RATE_TIP_ORDERS_PER_MINUTE=10
# TIP_RATE_CAPTURES_PER_MINUTE=30
# TIP_RATE_JUDGE_SESSIONS_PER_HOUR=10
# TIP_RATE_DEMO_SESSIONS_PER_MINUTE=30
# TIP_RATE_RESUMES_PER_MINUTE=20
# Per sandbox, not per IP: resume links one sandbox may make in 10 minutes.
# TIP_RATE_RESUME_LINKS_PER_TEN_MINUTES=5
